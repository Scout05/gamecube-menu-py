# Allow-list: only our own source is tracked. Everything else (IPL dumps, extracted
# resources, renders, decompiled Nintendo code, memory cards, local settings) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/run.py
!/ipl/
!/tools/
!/gamecube.jpg

__pycache__/
*.py[co]
*.bin
*.raw
*.gcp
*.png
*.wav
*.bak
# tool outputs, wherever they are written
*.gif
*.obj
*.mtl
*.c
*.txt
!/requirements.txt
